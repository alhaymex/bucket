{
  "expo": {
    "name": "bucket",
    "slug": "bucket",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-1024-light.png",
    "scheme": "bucket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-1024-light.png",
      "bundleIdentifier": "com.alhaymex.bucket",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alhaymex.bucket",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-1024-light.png",
        "monochromeImage": "./assets/images/app-icon-1024-light.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon-512-light.png",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/app-icon-512-dark.png",
            "backgroundColor": "#000000"
          },
          "android": {
            "image": "./assets/images/app-icon-512-light.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "bucket",
          "organization": "syferpool"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edb7d8a5-8784-483c-a76f-4216471fbcb5"
      }
    }
  }
}
