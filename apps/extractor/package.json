{
  "name": "@bucket/extractor",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:secret": "tsx src/scripts/generateSecret.ts"
  },
  "dependencies": {
    "@bucket/common": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jsdom": "^29.0.2",
    "puppeteer": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "vitest": "^4.1.5"
  }
}
